# Copy to .env (git-ignored) and fill in. Used by `npm run eval:bt` and `vercel dev`.
GEMINI_API_KEY=
BRAINTRUST_API_KEY=

# Optional
# EVAL_MODEL=gemini-3.7-flash-lite   # model to evaluate (default: the one the app picks)
# JUDGE_MODEL=gemini-3.8-flash       # model that grades the stories (default: newest non-Lite Flash)
# EVAL_TRIALS=3                      # runs per case, to smooth out randomness
